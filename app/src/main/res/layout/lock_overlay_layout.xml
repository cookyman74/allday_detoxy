<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 잠금 아이콘 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"
        android:layout_marginBottom="8dp" />

    <!-- 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="집중 모드 실행 중"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- 🆕 v9: 목표/할일 섹션 -->
    <LinearLayout
        android:id="@+id/goalSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1AFFFFFF"
        android:padding="16dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">
        
        <!-- 목표 헤더 -->
        <TextView
            android:id="@+id/goalHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 오늘의 목표"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        
        <!-- 목표 텍스트 -->
        <TextView
            android:id="@+id/goalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
        
        <!-- 할일 목록 컨테이너 -->
        <LinearLayout
            android:id="@+id/todoListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
        
        <!-- 더 있음 표시 -->
        <TextView
            android:id="@+id/todoMoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />
            
    </LinearLayout>
    
    <!-- 🆕 v9: 이모지만 표시 (프라이버시 모드) -->
    <TextView
        android:id="@+id/emojiOnlyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯"
        android:textSize="48sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- 남은 시간 라벨 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="남은 시간"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- 타이머 텍스트 (업데이트되는 부분) -->
    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textColor="#BB86FC"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- 진행률 표시 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:progressTint="#BB86FC"
        android:progressBackgroundTint="#33FFFFFF"
        android:layout_marginBottom="24dp" />

    <!-- 안내 메시지 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="타이머가 끝나면 다시 사용할 수 있습니다"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 공간 -->
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 닫기 버튼 -->
    <Button
        android:id="@+id/closeButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="닫기"
        android:textColor="#B3FFFFFF"
        android:background="@android:color/transparent"
        android:layout_marginBottom="32dp"
        style="?android:attr/buttonBarButtonStyle" />

</LinearLayout>
