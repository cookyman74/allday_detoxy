<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 다른 앱 위에 표시 권한 (오버레이) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 포그라운드 서비스 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- 정확 알람 권한 (Android 12+, 시간 기반 자동 실행) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- 부팅 완료 감지 (알람 재등록) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- 위치 권한 (위치 기반 자동 실행) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 백그라운드 위치 권한 (Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".DetoxyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlldayDetoxy"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AlldayDetoxy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AccessibilityService for app blocking -->
        <service
            android:name=".service.accessibility.FocusAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FocusTimerService for timer management (Foreground Service) -->
        <service
            android:name=".service.timer.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus timer countdown service" />
        </service>

        <!-- LockOverlayService for screen lock -->
        <service
            android:name=".service.overlay.LockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Lock screen overlay for focus timer" />
        </service>

        <!-- AutoRunAlarmReceiver for time-based auto-run -->
        <receiver
            android:name=".receiver.AutoRunAlarmReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.allday.detoxy.ACTION_AUTO_RUN_ALARM" />
            </intent-filter>
        </receiver>

        <!-- GeofenceTransitionsReceiver for location-based auto-run -->
        <receiver
            android:name=".receiver.GeofenceTransitionsReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.allday.detoxy.ACTION_GEOFENCE_TRANSITION" />
            </intent-filter>
        </receiver>

        <!-- BootCompletedReceiver for alarm re-registration (TODO: implement later) -->
        <!-- 
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        -->
    </application>

</manifest>